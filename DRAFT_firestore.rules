rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Validation Blueprints
    function isValidSymptom(data) {
      return data.userId == request.auth.uid &&
             data.symptom is string && data.symptom.size() > 0 && data.symptom.size() <= 100 &&
             data.severity is number && data.severity >= 1 && data.severity <= 10 &&
             data.timestamp is number && data.timestamp <= (request.time.toMillis() + 600000); // Allow 10 min clock skew
    }

    function isValidProfile(data) {
      return (data.displayName is string && data.displayName.size() <= 50) &&
             (data.bio is string && data.bio.size() <= 1000) &&
             (data.heartRate is number && data.heartRate >= 30 && data.heartRate <= 250) &&
             (data.bloodPressure is string && data.bloodPressure.size() <= 20) &&
             (data.spo2 is number && data.spo2 >= 50 && data.spo2 <= 100) &&
             (data.respRate is number && data.respRate >= 0 && data.respRate <= 100);
    }

    // Collection Rules
    match /symptoms/{symptomId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(existing().userId);
      allow create: if isSignedIn() && isValidSymptom(incoming()) && (incoming().keys().hasAll(['userId', 'symptom', 'severity', 'timestamp']) || incoming().keys().hasAll(['userId', 'symptom', 'severity', 'timestamp', 'createdAt']));
      allow update: if isOwner(existing().userId) && isValidSymptom(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['symptom', 'severity', 'timestamp'])
      );
      allow delete: if isOwner(existing().userId);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow write: if isOwner(userId) && isValidProfile(incoming());
    }
  }
}
